# quote-mcp's settings. Only the first two are needed; `npm run quotes -- config` shows every setting,
# where each came from, and what each feature still needs. The public site's choices (whether it shows
# the catalogue or the quotes, and notes) are in vocab/site.md's header, not here.

# Required: the Zotero library to read ("users/<id>" or "groups/<id>"), and an API key; read-only is enough.
QUOTE_ZOTERO_LIBRARY=users/1234567
QUOTE_ZOTERO_API_KEY=

# Optional: other Zotero libraries to import quote notes from, and the old Drupal site's database.
# QUOTE_ZOTERO_SOURCES=groups/2345678
# QUOTE_DRUPAL_URL=mysql://user:password@mariadb.localdomain/jmajerus_drp1

# Optional: quote-atlas's built maps, served at /map/.
# QUOTE_MAP_DIR=/opt/quote-mcp/map

# Optional: the public site's replica in D1, kept in step by the server, through the D1 proxy Worker
# (worker/proxy.ts) and its token.
# QUOTE_D1_PROXY_URL=https://quote-mcp-d1-proxy.example.workers.dev
# QUOTE_D1_PROXY_TOKEN=

# Concepts from terminology-mcp (docs/dev-briefs/human-work-from-terminology-mcp.md). Turn following on
# only on the server, in /etc/quote-mcp/env: progress is reported as "quote-mcp", so a second follower would
# fight the server's cursor. To try it here, point TERMINOLOGY_BASE at a terminology-mcp of your own.
# QUOTE_TERMS_SYNC=on
# TERMINOLOGY_BASE=http://127.0.0.1:8000

# Optional, for `npm run deploy`: the deploy account's SSH password.
# AUTHORING_DEPLOY_PASSWORD=

# The Cloudflare Access team (also set in /etc/quote-mcp/env on the host).
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
