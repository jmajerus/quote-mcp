# The Zotero library to read: "users/<user id>" or "groups/<group id>".
QUOTE_ZOTERO_LIBRARY=users/1234567
# A read-only key is enough for the survey and the import.
QUOTE_ZOTERO_API_KEY=
# QUOTE_ZOTERO_API=https://api.zotero.org
# A word list, one word per line, for the OCR check.
# QUOTE_DICTIONARY=/usr/share/dict/words
# The old Drupal site's database dump, read-only, for `npm run survey -- --source drupal`.
# QUOTE_DRUPAL_URL=mysql://user:password@mariadb.localdomain/jmajerus_drp1
# Other Zotero libraries to import quote notes from; quotes cite QUOTE_ZOTERO_LIBRARY's items where they match.
# QUOTE_ZOTERO_SOURCES=groups/2345678
# The quote store.
# QUOTE_DB=data/quotes.db
# The service: MCP at /mcp, admin pages at /admin, the JSON API at /api.
# QUOTE_HOST=0.0.0.0
# QUOTE_PORT=8010
# The concept sets; by default the checkout's vocab/sets.json.
# QUOTE_SETS=vocab/sets.json
# The concept maps' built files (quote-atlas), served at /map/; unset, /map/ is 404.
# QUOTE_MAP_DIR=/opt/quote-mcp/map
# The public site at /: none (the default), catalogue (concepts, sets, maps, works; no quoted text), or quotes.
# QUOTE_PUBLIC=catalogue
# Notes and quote comments on the public site (quotes level only): none (the default) or all; a note tagged private stays private.
# QUOTE_PUBLIC_NOTES=none
# A second port serving only the public snapshot's pages and API, and /map/, for a hostname with no login.
# QUOTE_PUBLIC_PORT=8001
# The public snapshot the public pages read; by default public.db beside the store.
# QUOTE_SNAPSHOT=data/public.db
# The public site's replica in D1, which the server's drain keeps in step: through the D1 proxy Worker
# (worker/proxy.ts)...
# QUOTE_D1_PROXY_URL=https://quote-mcp-d1-proxy.example.workers.dev
# QUOTE_D1_PROXY_TOKEN=
# ...or Cloudflare's REST API, with a token that can edit D1.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# QUOTE_D1_DATABASE_ID=
# The front page's title and introduction; by default the checkout's vocab/site.md.
# QUOTE_INTRO=vocab/site.md
