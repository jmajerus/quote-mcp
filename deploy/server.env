# The server's own settings: its paths and port. In git, with no secrets; each deploy writes them into the
# server's /etc/quote-mcp/generated.env with the server settings from .env (see src/settings.ts).
QUOTE_DB=/var/lib/quote-mcp/quotes.db
QUOTE_HOST=0.0.0.0
QUOTE_PORT=8000
QUOTE_DICTIONARY=/usr/share/dict/words
QUOTE_MAP_DIR=/opt/quote-mcp/map
