[Unit]
Description=quote-mcp: sync the Zotero mirror and import new or changed quote notes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quote
Group=quote
EnvironmentFile=/etc/quote-mcp/env
WorkingDirectory=/opt/quote-mcp/current
ExecStart=/usr/bin/node /opt/quote-mcp/current/dist/cli.js import
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/quote-mcp
