[Unit]
Description=quote-mcp MCP server (Streamable HTTP) and admin pages
After=network-online.target
Wants=network-online.target

[Service]
User=quote
Group=quote
EnvironmentFile=/etc/quote-mcp/generated.env
WorkingDirectory=/opt/quote-mcp/current
ExecStart=/usr/bin/node /opt/quote-mcp/current/dist/cli.js serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/quote-mcp

[Install]
WantedBy=multi-user.target
