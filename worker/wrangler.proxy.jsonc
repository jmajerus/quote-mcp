// The D1 proxy for quote-mcp's drain (worker/proxy.ts): D1's REST API shape at /query, through the
// public site's database binding, guarded by a bearer token (the D1_PROXY_TOKEN secret, set with
// `npx wrangler secret put D1_PROXY_TOKEN -c worker/wrangler.proxy.jsonc`). The drain can use the REST API
// instead (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, QUOTE_D1_DATABASE_ID); the proxy is faster. Locally,
// `npm run worker:proxy` runs it on the same local D1 as `npm run worker:dev`, with the token from
// worker/.dev.vars. Deployed at https://quote-mcp-d1-proxy.jmajerus.workers.dev; deploy with
// `npx wrangler deploy -c worker/wrangler.proxy.jsonc`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quote-mcp-d1-proxy",
  "main": "proxy.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quote-mcp-public",
      // The same database as worker/wrangler.jsonc's.
      "database_id": "06c4b49c-5e60-4601-a00e-f718bec81c08"
    }
  ]
}
