// The public site's Worker (worker/index.ts): the public pages and the maps' API from the snapshot's
// replica in D1, at quotes.majerus.us. Locally: `npm run worker:load` then `npm run worker:dev`. Deploy with
// `npx wrangler deploy -c worker/wrangler.jsonc`; a new migration goes out with
// `npx wrangler d1 migrations apply DB --remote -c worker/wrangler.jsonc`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quote-mcp-public",
  "main": "index.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": false,
  "routes": [{ "pattern": "quotes.majerus.us", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quote-mcp-public",
      "database_id": "06c4b49c-5e60-4601-a00e-f718bec81c08",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
